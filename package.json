{
  "name": "times-tables",
  "version": "1.0.0",
  "description": "A calm, terminal-styled times-tables practice app for kids. Builds to a single self-contained HTML file.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node build.mjs",
    "build:fast": "node build.mjs",
    "dev": "node build.mjs --watch",
    "test": "npm run build:fast && node --test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "sass": "^1.80.0",
    "typescript": "^5.6.0"
  }
}
